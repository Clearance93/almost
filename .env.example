# Appwrite Cloud project (server-side only — never expose APPWRITE_API_KEY to the browser)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# TablesDB database created by `npm run seed`
APPWRITE_DATABASE_ID=almost

# Seals the reveal payload (64 hex chars). Generate with: openssl rand -hex 32
ROUND_SECRET=
